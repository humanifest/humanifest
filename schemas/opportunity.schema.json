{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Humanifest opportunity record",
  "type": "object",
  "required": [
    "id",
    "project_id",
    "title",
    "pipeline_state",
    "problem",
    "humanitarian_relevance",
    "evidence",
    "code_surface",
    "proposed_change",
    "tests",
    "environment",
    "maintainer",
    "risks",
    "gates",
    "score_inputs",
    "sources"
  ],
  "properties": {
    "research_next_step": {
      "type": "string",
      "pattern": "\\S",
      "description": "Concrete independent research or verification step; not implementation approval. Remove when completed."
    },
    "next_external_status_check": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Planned manual review date; not a scheduled automation or live status check."
    },
    "id": {
      "type": "string",
      "pattern": "\\S"
    },
    "project_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "pipeline_state": {
      "enum": [
        "QUEUED",
        "PROJECT-AUDIT",
        "OPPORTUNITY-RESEARCH",
        "SHORTLISTED",
        "MAINTAINER-CHECK",
        "ENVIRONMENT-READY",
        "REPRODUCED",
        "BUILDING",
        "ADVERSARIAL-REVIEW",
        "HUMAN-REVIEW",
        "PR-OPEN",
        "MERGED",
        "RELEASED",
        "PARKED",
        "DECLINED"
      ]
    },
    "gates": {
      "type": "object",
      "required": [
        "humanitarian_relevance_supported",
        "repository_active",
        "external_contributions_accepted",
        "contribution_policy_understood",
        "ai_policy_understood",
        "problem_current_and_consequential",
        "behavior_reproducible_or_verifiable",
        "code_and_tests_located",
        "change_bounded",
        "regression_strategy_credible",
        "no_private_data_required",
        "security_and_licensing_risk_acceptable",
        "environment_feasible",
        "maintainer_interest_confirmed",
        "probable_reviewer_identified",
        "benefit_justifies_review_cost",
        "user_can_explain_line_by_line"
      ],
      "properties": {
        "humanitarian_relevance_supported": {
          "$ref": "#/$defs/gate"
        },
        "repository_active": {
          "$ref": "#/$defs/gate"
        },
        "external_contributions_accepted": {
          "$ref": "#/$defs/gate"
        },
        "contribution_policy_understood": {
          "$ref": "#/$defs/gate"
        },
        "ai_policy_understood": {
          "$ref": "#/$defs/gate"
        },
        "problem_current_and_consequential": {
          "$ref": "#/$defs/gate"
        },
        "behavior_reproducible_or_verifiable": {
          "$ref": "#/$defs/gate"
        },
        "code_and_tests_located": {
          "$ref": "#/$defs/gate"
        },
        "change_bounded": {
          "$ref": "#/$defs/gate"
        },
        "regression_strategy_credible": {
          "$ref": "#/$defs/gate"
        },
        "no_private_data_required": {
          "$ref": "#/$defs/gate"
        },
        "security_and_licensing_risk_acceptable": {
          "$ref": "#/$defs/gate"
        },
        "environment_feasible": {
          "$ref": "#/$defs/gate"
        },
        "maintainer_interest_confirmed": {
          "$ref": "#/$defs/gate",
          "if": {
            "properties": {
              "passed": {
                "const": true
              }
            },
            "required": [
              "passed"
            ]
          },
          "then": {
            "required": [
              "source_ids"
            ]
          }
        },
        "probable_reviewer_identified": {
          "$ref": "#/$defs/gate"
        },
        "benefit_justifies_review_cost": {
          "$ref": "#/$defs/gate"
        },
        "user_can_explain_line_by_line": {
          "$ref": "#/$defs/gate"
        }
      }
    },
    "score_inputs": {
      "type": "object",
      "required": [
        "humanitarian_benefit",
        "acceptance_probability",
        "technical_confidence",
        "review_burden",
        "deployment_probability"
      ],
      "properties": {
        "humanitarian_benefit": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "acceptance_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "technical_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "review_burden": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "deployment_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "problem": {
      "type": "string",
      "pattern": "\\S"
    },
    "humanitarian_relevance": {
      "type": "string",
      "pattern": "\\S"
    },
    "code_surface": {
      "type": "string",
      "pattern": "\\S"
    },
    "proposed_change": {
      "type": "string",
      "pattern": "\\S"
    },
    "tests": {
      "type": "string",
      "pattern": "\\S"
    },
    "environment": {
      "type": "string",
      "pattern": "\\S"
    },
    "maintainer": {
      "type": "string",
      "pattern": "\\S"
    },
    "risks": {
      "type": "string",
      "pattern": "\\S"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "pipeline_state": {
            "enum": [
              "ENVIRONMENT-READY",
              "REPRODUCED",
              "BUILDING",
              "ADVERSARIAL-REVIEW",
              "HUMAN-REVIEW",
              "PR-OPEN",
              "MERGED",
              "RELEASED"
            ]
          }
        },
        "required": [
          "pipeline_state"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "properties": {
              "maintainer_interest_confirmed": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pipeline_state": {
            "enum": [
              "BUILDING",
              "ADVERSARIAL-REVIEW",
              "HUMAN-REVIEW",
              "PR-OPEN",
              "MERGED",
              "RELEASED"
            ]
          }
        },
        "required": [
          "pipeline_state"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "properties": {
              "humanitarian_relevance_supported": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "repository_active": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "external_contributions_accepted": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "contribution_policy_understood": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "ai_policy_understood": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "problem_current_and_consequential": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "behavior_reproducible_or_verifiable": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "code_and_tests_located": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "change_bounded": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "regression_strategy_credible": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "no_private_data_required": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "security_and_licensing_risk_acceptable": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "environment_feasible": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "maintainer_interest_confirmed": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "probable_reviewer_identified": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "benefit_justifies_review_cost": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "user_can_explain_line_by_line": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "url",
        "accessed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "pattern": "^(https?://[^/\\s?#]+|file://(/|localhost/))\\S*$"
        },
        "accessed": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "type",
        "claim",
        "source_id"
      ],
      "properties": {
        "type": {
          "enum": [
            "measured",
            "modeled",
            "self_reported",
            "inferred"
          ]
        },
        "claim": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_id": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "passed",
        "rationale"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "description": "Evidence sources in this opportunity record supporting the gate rationale."
        }
      }
    }
  }
}

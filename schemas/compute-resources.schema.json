{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Humanifest compute resource ledger",
  "type": "object",
  "required": [
    "version",
    "as_of",
    "policy",
    "resources",
    "allocations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "as_of": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "policy": {
      "type": "string",
      "pattern": "\\S"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "allocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/allocation"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resource": {
      "type": "object",
      "required": [
        "id",
        "name",
        "provider",
        "resource_type",
        "status",
        "allowed_uses",
        "prohibited_uses",
        "requires_user_authorization_for_external_writes",
        "requires_identity_check",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "provider": {
          "type": "string",
          "pattern": "\\S"
        },
        "resource_type": {
          "enum": [
            "donated",
            "free",
            "sponsored",
            "paid",
            "local"
          ]
        },
        "status": {
          "enum": [
            "available",
            "unverified",
            "paused",
            "exhausted",
            "retired"
          ]
        },
        "allowed_uses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "prohibited_uses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "requires_user_authorization_for_external_writes": {
          "type": "boolean"
        },
        "requires_identity_check": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "allocation": {
      "type": "object",
      "required": [
        "id",
        "resource_id",
        "purpose",
        "authorized_by",
        "authorized_on"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "resource_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "purpose": {
          "type": "string",
          "pattern": "\\S"
        },
        "authorized_by": {
          "type": "string",
          "pattern": "\\S"
        },
        "authorized_on": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "additionalProperties": false
    }
  }
}
